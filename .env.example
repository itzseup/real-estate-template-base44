# Base44-compatible client (uses env var names that match the old Base44 SDK)
VITE_BASE44_URL=your-supabase-project-url
VITE_BASE44_ANON_KEY=your-supabase-anon-key

# Supabase configuration (direct)
VITE_SUPABASE_URL=your-supabase-project-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-side / admin (service_role key) — never expose in the browser
SUPABASE_URL=your-supabase-project-url
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
